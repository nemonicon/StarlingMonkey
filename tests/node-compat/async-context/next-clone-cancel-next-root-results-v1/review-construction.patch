+def members(index_ref, count, request_inputs):
+    index = doc(index_ref)
+    root = Path(index_ref['path']).parent
+    assert len(index['files']) == count
+    names, directories = set(), set()
+    assert index_ref in request_inputs
+    for item in index['files']:
+        rel = Path(item['path'])
+        assert not rel.is_absolute() and rel.parts and '..' not in rel.parts and rel.as_posix() == item['path']
+        assert item['path'] not in names
+        names.add(item['path'])
+        directories.update(p.as_posix() for p in rel.parents if p != Path('.'))
+        ref = dict(path=str(root / rel), sha256=item['sha256'], bytes=item['bytes'])
+        assert ref in request_inputs
+        checked(ref)
+    nodes = list(root.rglob('*'))
+    assert not any(p.is_symlink() for p in nodes)
+    assert {p.relative_to(root).as_posix() for p in nodes if p.is_file()} == names | {'index.json'}
+    assert {p.relative_to(root).as_posix() for p in nodes if p.is_dir()} == directories
+
