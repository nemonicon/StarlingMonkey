+def package(selection, request_inputs):
+    assert selection['state'] == 'FRESH_COMPILER_PACKAGE_SELECTED_V1'
+    pkg = selection['package']
+    root = Path(pkg['root'])
+    assert root.resolve(strict=True) == root and root.is_dir()
+    names, links = set(), set()
+    for item in pkg['files']:
+        rel = Path(item['relativePath'])
+        assert not rel.is_absolute() and '..' not in rel.parts and rel.as_posix() == item['relativePath']
+        assert item['relativePath'] not in names
+        names.add(item['relativePath'])
+        ref = {k: item[k] for k in ('path', 'sha256', 'bytes')}
+        assert ref['path'] == str(root / rel) and ref in request_inputs
+        checked(ref)
+        assert stat.S_IMODE((root / rel).stat().st_mode) == item['mode']
+    for item in pkg['links']:
+        rel = Path(item['path'])
+        assert not rel.is_absolute() and '..' not in rel.parts and rel.as_posix() == item['path']
+        assert item['path'] not in links
+        links.add(item['path'])
+        p = root / rel
+        assert p.is_symlink() and os.readlink(p) == item['target']
+        assert str(p.resolve(strict=True)) == item['resolvedPath'] and root in p.resolve(strict=True).parents
+    actual_files, actual_links = set(), set()
+    pending = [root]
+    while pending:
+        for p in pending.pop().iterdir():
+            rel = p.relative_to(root).as_posix()
+            if p.is_symlink():
+                actual_links.add(rel)
+            elif p.is_dir():
+                pending.append(p)
+            else:
+                assert p.is_file()
+                actual_files.add(rel)
+    assert (actual_files, actual_links) == (names, links)
+
