+def import_graph(graph, returned, component):
+    # Check every captured own field, deriving the Array length from actual
+    # returned tuples; no predecessor import function count is used.
+    serial = 2
+    def data_property(name, value, length=False):
+        return dict(key=dict(string=name), enumerable=not length, configurable=not length,
+                    kind='data', writable=True, value=value)
+    pairs = []
+    for index, pair in enumerate(returned):
+        serial += 1
+        properties = [data_property(str(i), dict(type='string', value=v)) for i, v in enumerate(pair)]
+        properties.append(data_property('length', dict(type='number', value='2'), True))
+        pairs.append(data_property(str(index), dict(type='Array', id=serial, properties=properties)))
+    pairs.append(data_property('length', dict(type='number', value=str(len(returned))), True))
+    expected = dict(type='object', id=0, properties=[
+        data_property('component', dict(type='Uint8Array', id=1, byteLength=component['bytes'],
+                      sha256=component['sha256'], file=component)),
+        data_property('imports', dict(type='Array', id=2, properties=pairs)),
+        data_property('debug', dict(type='undefined'))])
+    assert graph == expected, 'complete actual returned own graph differs from selected API shape'
+    return serial + 1
+
