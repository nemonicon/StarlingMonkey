+// A lone branch cancellation waits for the source EOF/error of its survivor.
+// Once source cancellation starts, its returned promise alone owns settlement.
+static bool clone_tee_settle_terminal_cancel(JSContext *cx, JS::HandleObject state) {
+  bool cancel_started = false;
+  if (!clone_tee_get_bool(cx, state, CloneTeeSlot::CancelStarted, &cancel_started)) {
+    return false;
+  }
+  if (cancel_started) {
+    return true;
+  }
+  JS::RootedObject promise(cx);
+  if (!clone_tee_get_branch(cx, state, CloneTeeSlot::CancelPromise, &promise)) {
+    return false;
+  }
+  return JS::ResolvePromise(cx, promise, JS::UndefinedHandleValue);
 }
 
