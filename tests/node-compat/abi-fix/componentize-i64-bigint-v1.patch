+// Canonical core i64 represents both signed and unsigned WIT integers. Preserve
+// the full bit domain: negative s64 BigInts and high u64 BigInts are both valid.
+static bool bigint_to_i64_bits(const JS::BigInt *value, uint64_t *bits) {
+  if (JS::detail::BigIntIsUint64(value, bits)) {
+    return true;
+  }
+  int64_t signed_value;
+  if (!JS::detail::BigIntIsInt64(value, &signed_value)) {
+    return false;
+  }
+  *bits = static_cast<uint64_t>(signed_value);
+  return true;
+}
