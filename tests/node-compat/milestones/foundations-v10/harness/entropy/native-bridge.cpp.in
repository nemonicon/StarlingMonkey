// UNCOMPILED PROPOSAL. Not linked into any production or test engine.
// entropy-policy.h and its functions below are proposed new PRIVATE GUEST
// symbols, not existing embedding APIs and not host services.
#include "extension-api.h"
#include "host_api.h"
#include "entropy-policy.h"
#include "fill-algorithm.h"
#include <cstring>

static int copy_selected_random_chunk(void *, unsigned char *destination, size_t length) {
  auto result = host_api::Random::get_bytes(length); // Existing API, not an adapter import.
  if (result.is_err()) return 0;
  auto bytes = std::move(result.unwrap()); // Existing HostBytes owns its canonical buffer.
  if (bytes.size() != length || (length && !bytes.begin())) {
    if (bytes.begin()) sm_entropy_clear(bytes.begin(), bytes.size());
    return 0;
  }
  std::memcpy(destination, bytes.begin(), length);
  sm_entropy_clear(bytes.begin(), bytes.size());
  // HostBytes destructor releases the temporary. Ownership never transfers to
  // OpenSSL/JS; no canonical buffer survives this call or a snapshot.
  return 1;
}

extern "C" int sm_node_secure_random_fill(unsigned char *destination, size_t length) {
  // Evaluate policy even for a zero-length request. OFF and pre-runtime calls
  // must not advertise that secure entropy is available.
  if (sm_node_entropy_status() != SmNodeEntropyStatus::Ready) return 0;
  return sm_entropy_fill_chunks(destination, length, copy_selected_random_chunk, nullptr);
}
