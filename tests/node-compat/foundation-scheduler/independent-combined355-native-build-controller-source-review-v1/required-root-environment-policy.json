{
  "schemaVersion": 1,
  "mandatoryBeforeControllerSpawn": true,
  "removePrefixes": [
    "BASH_FUNC_"
  ],
  "removeExactNames": [
    "BASH_ENV",
    "ENV",
    "SHELLOPTS",
    "BASHOPTS",
    "CDPATH",
    "GLOBIGNORE"
  ],
  "preserveExactNames": [
    "HOME",
    "home",
    "CODEX_HOME"
  ],
  "rootAuthorityMustBindPolicy": true,
  "rootLauncherMustEnforcePolicy": true,
  "actualChildMustContainNoRemovedEntries": true,
  "recordRemovedVariableNamesOnly": true,
  "recordEnvironmentValues": false,
  "scope": "Known inherited Bash function and startup controls; not an OS or universal environment sandbox"
}
