  "facts": [
    {
      "id": "F1",
      "file": "runtime/engine.cpp",
      "symbol": "Engine::reset",
      "finding": "Clears rejection Set, calls EventLoop::reset, timers::reset, EventLoop::reset again, then full GC. It does not clear Promise jobs, module cache, FetchEvent singleton or all host handles.",
      "evidence": "source-verified"
    },
    {
      "id": "F2",
      "file": "runtime/event_loop.cpp",
      "symbol": "EventLoop::reset",
      "finding": "Cancels while iterating live std::vector<RefPtr<AsyncTask>>, ignores bool results, clears owners, forces interest_cnt=0, clears tick storage and strict latches. No reset-in-progress guard exists.",
      "evidence": "source-verified"
    },
    {
      "id": "F3",
      "file": "builtins/web/timers.cpp",
      "symbol": "TimersMap/TimerTask::cancel/timers::reset",
      "finding": "TimersMap stores raw AsyncTask pointers. TimerTask::cancel drops pollable/marks handle but leaves map entries. Clearing sole queue RefPtrs before timers::reset can destroy tasks that timers::reset then dereferences. This is a conditional source ownership proof, not an executed fault.",
      "evidence": "source-based-bug"
    },
    {
      "id": "F4",
      "file": "runtime/event_loop.cpp",
      "symbol": "EventLoop::cancel_async_task",
      "finding": "Erases queue owner before invoking cancel through the constRefPtr argument. An ordinary raw-pointer conversion creates a temporary RefPtr and keeps native task alive; an argument aliasing the erased vector element can become invalid. A native RefPtr alone does not trace JS edges after detachment.",
      "evidence": "source-based-API-hazard"
    },
    {
      "id": "F5",
      "file": "include/extension-api.h",
      "symbol": "Engine::queue_async_task/AsyncTask",
      "finding": "Queue API returnsvoid; implementation std::vector.emplace_back has no recoverable enqueue result. Creation sites may acquire/register resources before enqueue. bool cancel has no unified distinction among already-finished, unsupported, close failure or JS exception.",
      "evidence": "source-verified"
    },
    {
      "id": "F6",
      "file": "host-apis/wasi-0.2.0/host_api.cpp",
      "symbol": "BodyWriteAllTask::cancel/BodyAppendTask::cancel",
      "finding": "Both explicitly assert cancellation is unreachable then returntrue; they do not implement abort/drop/settlement. Completion callbacks must not be reused as successful cancellation callbacks.",
      "evidence": "source-verified"
    },
    {
      "id": "F7",
      "file": "builtins/web/fetch/request-response.cpp",
      "symbol": "BodyFutureTask::cancel/ResponseFutureTask::cancel",
      "finding": "Both are TODO methods that only invalidate handle_. ResponseFutureTask::abort is a distinct path that invokes abort_fetch and unsubscribes future; it is not the generic cancel implementation.",
      "evidence": "source-verified"
    },
    {
      "id": "F8",
      "file": "host-apis/wasi-0.2.0/host_api.cpp",
      "symbol": "HttpIncomingBody::subscribe/unsubscribe/close",
      "finding": "subscribe returns a new pollable without assigning the cached field used by unsubscribe; close is a TODO returning success. A correct owned subscription/drop path is required.",
      "evidence": "source-verified"
    },
    {
      "id": "F9",
      "file": "host-apis/wasi-0.2.0/host_api.cpp",
      "symbol": "AsyncTask::select/poll_handles",
      "finding": "select prunes invalid task entries after EventLoop previously observed nonempty tasks. All-invalid leaves an empty poll list; poll_handles assumes ready results/min_element. New cancellation must handle empty-after-prune explicitly.",
      "evidence": "source-based-bug"
    },
    {
      "id": "F10",
      "file": "builtins/web/timers.cpp",
      "symbol": "TimerTask constructor/run/clear",
      "finding": "Timer factory registers raw map pointer and subscribes before void enqueue; next_timer_id increments and reset rewinds it to1. TimerTask itself does not increment event-loop interest. Running callbacks are special: clear can remove map state even when task was dequeued.",
      "evidence": "source-verified"
    },
    {
      "id": "F11",
      "file": "runtime/engine.cpp",
      "symbol": "init_js/rejection_tracker/clear_unhandled_promise_rejections",
      "finding": "Uses internal job queues and a Promise rejection Set. Clearing that Set does not clear queued reactions, pending promises or future native completions.",
      "evidence": "source-verified"
    },
    {
