xec", "execFile", "execFileSync", "execSync", "fork", "spawn", "spawnSync"], "callablePolicy": "Every non-default export is a function that immediately throws ERR_SM_NODE_UNSUPPORTED on invocation or construction, including during snapshot initialization"}, "node:buffer": {"aliases": ["buffer"], "globals": ["Buffer (only if profile selected)"], "status": "partial", "exports": ["Blob", "Buffer", "File", "INSPECT_MAX_BYTES", "SlowBuffer", "atob", "btoa", "constants", "default", "isAscii", "isUtf8", "kMaxLength", "kStringMaxLength", "resolveObjectURL", "transcode"], "supportedStatic": ["alloc(size:number-integer, fill?:number)", "from(string, utf8|utf-8|hex)", "from(Uint8Array): copy", "from(ArrayBuffer, integerOffset?, integerLength?): shared view", "isBuffer", "isEncoding: profile encodings only", "byteLength(string|Uint8Array|ArrayBuffer, encoding?)", "allocUnsafe(finite nonnegative number <=16777216): truncate length; fresh zeroed owned Buffer; no pool"], "supportedPrototype": ["toString(utf8|utf-8|hex, integerStart?, integerEnd?)", "subarray", "slice: shared view", "parent", "offset"], "encodingNames": ["utf8", "utf-8", "hex"], "limits": {"MAX_LENGTH": 16777216, "MAX_STRING_LENGTH": 33554432, "MAX_SOURCE_CODE_UNITS": 1048576, "poolSize": 0}, "numericExports": {"INSPECT_MAX_BYTES": 50, "kMaxLength": 16777216, "kStringMaxLength": 33554432}, "importOnlyExports": ["Blob", "File", "SlowBuffer", "atob", "btoa", "isAscii", "isUtf8", "resolveObjectURL", "transcode"], "unsupportedStatic": ["copyBytesFrom", "of", "allocUnsafeSlow", "compare", "concat"], "unsupportedPrototypePolicy": "Every other own Node Buffer prototype function is explicitly installed as a throwing function; inventory checked against pinned Node at test time", "deviations": ["No deprecated Buffer or SlowBuffer constructor", "No slab allocator or uninitialized storage; allocUnsafe guarantees fresh zeroed exact backing at offset 0 and ignores poolSize", "No arrays, array-like inputs, DataView, non-Uint8 typed arrays, SharedArrayBuffer or resizable backing stores", "No copying slice: Buffer.slice shares storage", "Source strings limited to 1048576 UTF-16 code units", "Only allocUnsafe truncates finite nonnegative fractional sizes; other fractional sizes/index coercions remain outside the declared overloads", "Default object and constants frozen; CJS mutation synchronization unsupported", "Detached/shared/resizable ArrayBuffers and views fail ERR_SM_NODE_UNSUPPORTED; inherited Uint8Array APIs keep engine behavior", "allocUnsafe validates the raw requested size before truncation; requests above 16777216 reject even if their truncated length would fit", "allocUnsafe uses captured constructors and own data code/module/operation fields for validation; detailed Node error text and pooled backing semantics differ", "allocUnsafeSlow remains explicitly deferred; no legacy Buffer constructor or other method support follows"]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.2", "nodeVersion": "v22.14.0", "status": "Optional Path foundation selected only by NODE_COMPAT_PATH=ON; core m0.1 manifest is unchanged.", "moduleContract": "Explicit finite ESM export records. Root default equals posix; default and named functions initially share identity; all variants share the same posix/win32 object graph. Bare aliases select the same values, with module namespace records cached per registered specifier.", "modules": {"node:path": {"aliases": ["path"], "status": "partial", "exports": ["_makeLong", "basename", "default", "delimiter", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "posix", "relative", "resolve", "sep", "toNamespacedPath", "win32"], "callablePolicy": "All 13 callable exports implement lexical path operations; matchesGlob additionally enforces explicit profile budgets. No operation consults a host capability.", "supportedStatic": ["_makeLong", "basename", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "relative", "resolve", "toNamespacedPath"], "limits": {"pathCodeUnits": 4096, "patternCodeUnits": 1024, "braceAlternatives": 128, "braceOutputCodeUnits": 32768, "braceDepth": 8, "braceRewrites": 16, "extglobDepth": 8, "segments": 128, "magicSegmentCodeUnits": 256, "stateEstimate": 65536, "workEstimate": 2000000, "workUnits": 250000, "stateKeyCodeUnits": 32768, "globstarRecursion": 32, "dfaCacheUnits": 262144}, "deviations": ["Default namespace is POSIX and virtual cwd is always '/'; no host cwd or drive-specific environment is queried.", "matchesGlob uses fixed POSIX-host case sensitivity for both variants, suppresses Node's experimental warning and uses explicitly patched minimatch 11.0.1 rather than Node 22.14's vulnerable matcher.", "matchesGlob rejects resource-budget exhaustion with RangeError code ERR_SM_NODE_PATH_BUDGET and a resource string instead of truncating expansions or returning a false result.", "TypeError names and ERR_INVALID_ARG_TYPE codes match the supported invalid input domain; received-value message rendering differs from Node's internal inspector.", "Default path objects remain mutable; ESM named bindings capture their initial members. syncBuiltinESMExports is unavailable."]}, "node:path/posix": {"aliases": ["path/posix"], "status": "partial", "exports": ["_makeLong", "basename", "default", "delimiter", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "posix", "relative", "resolve", "sep", "toNamespacedPath", "win32"], "callablePolicy": "All 13 callable exports implement lexical path operations; matchesGlob additionally enforces explicit profile budgets. No operation consults a host capability.", "supportedStatic": ["_makeLong", "basename", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "relative", "resolve", "toNamespacedPath"], "limits": {"pathCodeUnits": 4096, "patternCodeUnits": 1024, "braceAlternatives": 128, "braceOutputCodeUnits": 32768, "braceDepth": 8, "braceRewrites": 16, "extglobDepth": 8, "segments": 128, "magicSegmentCodeUnits": 256, "stateEstimate": 65536, "workEstimate": 2000000, "workUnits": 250000, "stateKeyCodeUnits": 32768, "globstarRecursion": 32, "dfaCacheUnits": 262144}, "deviations": ["Default namespace is POSIX and virtual cwd is always '/'; no host cwd or drive-specific environment is queried.", "matchesGlob uses fixed POSIX-host case sensitivity for both variants, suppresses Node's experimental warning and uses explicitly patched minimatch 11.0.1 rather than Node 22.14's vulnerable matcher.", "matchesGlob rejects resource-budget exhaustion with RangeError code ERR_SM_NODE_PATH_BUDGET and a resource string instead of truncating expansions or returning a false result.", "TypeError names and ERR_INVALID_ARG_TYPE codes match the supported invalid input domain; received-value message rendering differs from Node's internal inspector.", "Default path objects remain mutable; ESM named bindings capture their initial members. syncBuiltinESMExports is unavailable."]}, "node:path/win32": {"aliases": ["path/win32"], "status": "partial", "exports": ["_makeLong", "basename", "default", "delimiter", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "posix", "relative", "resolve", "sep", "toNamespacedPath", "win32"], "callablePolicy": "All 13 callable exports implement lexical path operations; matchesGlob additionally enforces explicit profile budgets. No operation consults a host capability.", "supportedStatic": ["_makeLong", "basename", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "relative", "resolve", "toNamespacedPath"], "limits": {"pathCodeUnits": 4096, "patternCodeUnits": 1024, "braceAlternatives": 128, "braceOutputCodeUnits": 32768, "braceDepth": 8, "braceRewrites": 16, "extglobDepth": 8, "segments": 128, "magicSegmentCodeUnits": 256, "stateEstimate": 65536, "workEstimate": 2000000, "workUnits": 250000, "stateKeyCodeUnits": 32768, "globstarRecursion": 32, "dfaCacheUnits": 262144}, "deviations": ["Default namespace is POSIX and virtual cwd is always '/'; no host cwd or drive-specific environment is queried.", "matchesGlob uses fixed POSIX-host case sensitivity for both variants, suppresses Node's experimental warning and uses explicitly patched minimatch 11.0.1 rather than Node 22.14's vulnerable matcher.", "matchesGlob rejects resource-budget exhaustion with RangeError code ERR_SM_NODE_PATH_BUDGET and a resource string instead of truncating expansions or returning a false result.", "TypeError names and ERR_INVALID_ARG_TYPE codes match the supported invalid input domain; received-value message rendering differs from Node's internal inspector.", "Default path objects remain mutable; ESM named bindings capture their initial members. syncBuiltinESMExports is unavailable."]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.10", "nodeVersion": "v22.14.0", "status": "Optional bounded Events extension selected only by NODE_COMPAT_EVENTS=ON. m0.10 adds a finite addAbortListener facade and selected native protected-listener semantics; no external host interface is required. Support remains limited to the explicit policy below.", "moduleContract": "Exactly the16 pinned Node22 ESM names. Default is the callable EventEmitter constructor and equals named EventEmitter and default.EventEmitter. Exported functions share initial identity with default static members. errorMonitor is a unique symbol, captureRejectionSymbol is Symbol.for(nodejs.rejection); captureRejections/usingDomains are false and defaultMaxListeners is10. Static defaultMaxListeners is a mutable accessor while its named ESM export captures10. Selected literal CommonJS lowering will return default; runtime require and syncBuiltinESMExports remain excluded. Proposed m0.10 retains the16 export names, default/static identities and alias/cache contract; addAbortListener uses a guest protected-option Symbol and a finite JavaScript facade.", "modules": {"node:events": {"aliases": ["events"], "status": "partial", "exports": ["EventEmitter", "EventEmitterAsyncResource", "addAbortListener", "captureRejectionSymbol", "captureRejections", "default", "defaultMaxListeners", "errorMonitor", "getEventListeners", "getMaxListeners", "init", "listenerCount", "on", "once", "setMaxListeners", "usingDomains"], "callablePolicy": "Listed synchronous methods accept string/symbol event names and ordinary initialized EventEmitter/mixin receivers. Deferred callable exports throw ERR_SM_NODE_UNSUPPORTED on call or construction, including during initialization. No Proxy or fabricated host operation.", "supportedStatic": ["EventEmitter", "init", "getEventListeners", "getMaxListeners", "listenerCount", "setMaxListeners", "addAbortListener"], "supportedPrototype": ["setMaxListeners", "getMaxListeners", "emit", "addListener", "on", "prependListener", "once", "prependOnceListener", "removeListener", "off", "removeAllListeners", "listeners", "rawListeners", "listenerCount", "eventNames"], "unsupportedStatic": ["EventEmitterAsyncResource", "on", "once"], "unsupportedPrototypePolicy": "Only the15 listed EventEmitter prototype methods are claimed. AsyncResource instances cannot be constructed.", "numericExports": {"defaultMaxListeners": 10}, "limits": {"listenersPerEvent": 65536, "eventNamesPerEmitter": 4096, "nestedEmitEntries": 64}, "deviations": ["Event-name coercion beyond strings/symbols is explicitly deferred even though Node accepts other property-key values.", "Resource caps throw RangeError ERR_SM_NODE_LIMIT while preserving already-registered state; Node has no corresponding fixed caps.", "Listener warning thresholds retain advisory behavior and warned markers, but process warning delivery is deferred; no console/stdio import is introduced.", "captureRejections=true and its global setter are deferred until correct scheduler/error propagation; false remains supported.", "Static once promises, on async iteration and EventEmitterAsyncResource are explicit throwing stubs.", "getEventListeners/getMaxListeners/setMaxListeners support EventEmitter-compatible targets; native EventTarget integration is deferred.", "Invalid argument names/codes are matched for tested supported cases; detailed received-value messages and non-Error error-event rendering differ.", "Private internal symbol layout, arbitrary external mutation of _events, cross-realm receivers, runtime CommonJS loading and mutable ESM synchronization are not claimed.", "Target Symbol.dispose is captured for native disposal interoperability; pinned Node22 registry identity can differ. Target symbol identity still requires a component test.", "The current selected-profile strict v3 error policy is fatal/discard at a drained boundary, not Node process error handlers/nextTick semantics.", "Node EventTarget parity is not claimed, including registration getter timing and pre-stopped stopPropagation/cancelBubble synthetic events. Native function target receiver correction is proposed separately.", "General AbortSignal container finalization and option-signal Terminator unlinking are pre-existing lifetime gaps and need a separate prerequisite review; no immediate reclamation claim.", "addAbortListener targets structural signal validation, dynamic public hooks, once/disposal/already-aborted scheduling and protected stopImmediatePropagation order. Detailed received-value messages differ; no general EventTarget, process or AsyncResource parity is claimed.", "Selected native EventTarget public add/remove/dispatch reject uninitialized class prototypes with TypeError, matching the uncoded prototype errors observed in pinned Node22. Detailed messages and ERR_INVALID_THIS normalization for other receivers remain outside this guard. Structural addAbortListener signal validation is preserved."]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.4", "nodeVersion": "v22.14.0", "status": "Optional bounded StringDecoder foundation selected only by NODE_COMPAT_STRING_DECODER=ON; requires the core Buffer and native web codec builtins. Other manifests remain unchanged.", "moduleContract": "Exactly the two pinned Node22 ESM bindings StringDecoder and default. The ordinary mutable default object initially has only StringDecoder, identical to the named constructor. Named bindings capture their initial values; default-object mutation does not synchronize ESM bindings. Selected literal CommonJS lowering returns default. Runtime require and syncBuiltinESMExports remain excluded.", "modules": {"node:string_decoder": {"aliases": ["string_decoder"], "status": "partial", "exports": ["StringDecoder", "default"], "callablePolicy": "StringDecoder supports the listed UTF-8 aliases and hex, including ordinary constructor/call receivers and captured private encoding. Node-recognized deferred encodings throw ERR_SM_NODE_UNSUPPORTED at construction, including during componentization. Unknown labels throw TypeError ERR_UNKNOWN_ENCODING. No Proxy or host operation is used.", "supportedStatic": ["StringDecoder"], "supportedPrototype": ["write", "end", "text", "lastChar", "lastNeed", "lastTotal"], "encodingNames": ["utf8", "utf-8", "hex"], "limits": {"inputBytes": 16777216, "stateBytes": 7, "lastCharBytes": 4, "pendingInputBytes": 3}, "deviations": ["Only UTF-8 and hex are implemented. ASCII, latin1/binary, UTF-16LE/UCS-2, base64 and base64url are recognized but explicitly unavailable; no full StringDecoder support is claimed.", "Encoding names are case-insensitive under the pinned normalization algorithm; undefined, null and the empty string select UTF-8. Boxed/custom labels use the tested length-before-lowercase coercion order.", "write accepts strings unchanged and ordinary fixed unshared ArrayBufferViews as raw bytes; bare ArrayBuffer, shared, resizable and detached byte inputs are rejected. Input cap violations throw RangeError ERR_SM_NODE_LIMIT.", "Strings passed to write are returned unchanged before receiver validation and do not consume pending bytes. The byte cap applies to byte input, not this zero-copy string passthrough.", "State uses owned seven-byte fixed Buffer storage, with a fresh live four-byte lastChar view on every read. Node Buffer pool machinery and undocumented storage identities beyond the tested state/view contract are not implemented.", "Public encoding mutation does not change the private constructor-selected encoding. Mutating carry bytes is observable. Arbitrary replacement/corruption of the exposed internal-symbol storage, counter fields or encoding marker is excluded; detached or out-of-bounds-count storage is rejected with TypeError ERR_SM_NODE_DECODER_STATE.", "text clears pending counters before the observable input.slice(offset) call and then uses the observable receiver.write. It validates view backing/limits before slice may allocate; resizable/shared/detached views remain excluded.", "Detailed error messages, deliberately modified Buffer constructors/species, cross-realm inputs and arbitrary mutation of captured intrinsics during installation are not claimed. After installation the facade uses captured codec/Buffer methods and byte-view length getters.", "No async context, scheduler, filesystem, process, entropy or other host interface is required. Correct generic native TextDecoder ownership is a prerequisite; unrelated fatal-decoding lifecycle and Rust allocator-abort behavior are not solved by this facade."]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.5", "nodeVersion": "v22.14.0", "status": "Prepared optional bounded Assert facade; planned NODE_COMPAT_ASSERT=ON selection. Shared registration/build integration and native component gates are pending.", "moduleContract": "Both modules declare exactly22 pinned Node22 ESM exports. node:assert default===ok; named strict===node:assert/strict default; strict.strict===strict; strict.ok===root.ok. Strict equal/notEqual/deepEqual/notDeepEqual alias the root strict variants. Functions on each default initially share identity with named exports; later default-property reassignment does not rewrite named ESM cells. Future selected literal CommonJS lowering may return default; runtime require and syncBuiltinESMExports are excluded.", "modules": {"node:assert": {"aliases": ["assert"], "status": "partial", "exports": ["AssertionError", "CallTracker", "deepEqual", "deepStrictEqual", "default", "doesNotMatch", "doesNotReject", "doesNotThrow", "equal", "fail", "ifError", "match", "notDeepEqual", "notDeepStrictEqual", "notEqual", "notStrictEqual", "ok", "partialDeepStrictEqual", "rejects", "strict", "strictEqual", "throws"], "callablePolicy": "Deferred functions synchronously throw TypeError ERR_SM_NODE_UNSUPPORTED with operation on call and construction, including application initialization. Supported throws/doesNotThrow execute the callback before applicable matcher handling. A successful doesNotThrow returns without consulting an unused matcher.", "deviations": ["Auto messages use bounded opaque-object rendering, without util.inspect, custom inspectors, V8 source-file expression lookup, rich diffs, color or exact Node stack framing. Successful assertions do not render diagnostic inputs.", "AssertionError preserves tested code/name/operator/generatedMessage and actual/expected identity. stackStartFn/stackStartFunction are ignored; details is explicitly deferred. Native error stack layout, custom message diff decoration and prototype inspection helpers differ.", "Ordinary same-realm Error messages are rethrown by identity for ok/equality/fail/match; throws matcher failure renders its supplied message, matching the pinned reference. Cross-realm native-error detection and proxies posing as errors/regexps are not claimed.", "Complex exception validation objects and Error-instance matchers are deferred. Error constructors/classes, ordinary predicates returning exactly true and native RegExp matching are supported.", "RegExp matching uses captured native exec and retains lastIndex behavior; regex algorithmic complexity remains the JavaScript engine's responsibility.", "Async helpers are synchronous explicit unsupported operations rather than partial Promise implementations. No async scheduling or AsyncLocalStorage behavior is claimed.", "Warning delivery for deprecated fail overload and CallTracker is deferred. No process/stdio/clock/random/filesystem capability is introduced.", "Support is not complete Node Assert compatibility or a prerequisite proven by readable-stream4.7: that package uses a private local assertion helper."], "supportedStatic": ["AssertionError", "ok", "strict", "equal", "notEqual", "strictEqual", "notStrictEqual", "fail", "ifError", "throws", "doesNotThrow", "match", "doesNotMatch"], "unsupportedStatic": ["deepEqual", "notDeepEqual", "deepStrictEqual", "notDeepStrictEqual", "partialDeepStrictEqual", "rejects", "doesNotReject", "CallTracker"]}, "node:assert/strict": {"aliases": ["assert/strict"], "status": "partial", "exports": ["AssertionError", "CallTracker", "deepEqual", "deepStrictEqual", "default", "doesNotMatch", "doesNotReject", "doesNotThrow", "equal", "fail", "ifError", "match", "notDeepEqual", "notDeepStrictEqual", "notEqual", "notStrictEqual", "ok", "partialDeepStrictEqual", "rejects", "strict", "strictEqual", "throws"], "callablePolicy": "Shares the root implementation, references and deferred-operation policy. The four strict aliases do not wrap or duplicate functions.", "supportedStatic": ["AssertionError", "ok", "strict", "equal", "notEqual", "strictEqual", "notStrictEqual", "fail", "ifError", "throws", "doesNotThrow", "match", "doesNotMatch"], "unsupportedStatic": ["deepEqual", "notDeepEqual", "deepStrictEqual", "notDeepStrictEqual", "partialDeepStrictEqual", "rejects", "doesNotReject", "CallTracker"], "deviations": ["Shares all root diagnostic, same-realm, overload and deferred-operation restrictions. Default is root.strict and strict.strict is self; equal/notEqual/deepEqual/notDeepEqual alias root strict variants without wrappers."]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.6", "nodeVersion": "v22.14.0", "status": "Prepared optional bounded Querystring facade; planned NODE_COMPAT_QUERYSTRING=ON selection. Shared registration/build integration and native component gates are pending.", "moduleContract": "Exactly8 pinned ESM exports. Default is an ordinary object whose initial method references match the named exports; encode===stringify and decode===parse. Reassigning a default property does not rewrite named bindings, while parser/stringifier use mutable default escape/unescape hooks as pinned Node does. Future selected literal CommonJS lowering may return default; runtime require and syncBuiltinESMExports remain excluded. Depends on the existing guest Buffer constructor supplied privately to the factory; no global Buffer injection or new host capability.", "modules": {"node:querystring": {"aliases": ["querystring"], "status": "partial", "exports": ["decode", "default", "encode", "escape", "parse", "stringify", "unescape", "unescapeBuffer"], "callablePolicy": "Nonstring unescapeBuffer overloads throw TypeError ERR_SM_NODE_UNSUPPORTED with operation on call or construction. Resource caps throw RangeError ERR_SM_NODE_LIMIT. No blank objects, universal Proxy or silent failure substitutes for declared bindings. Null-prototype output; duplicate key aggregation; safe own __proto__ fields; custom separators/equal delimiters; Node1000 default segment limit; positive integer maxKeys decrement and exact pinned fractional/nonpositive/NaN/Infinity behavior within profile hard caps. Empty segments count toward Node maxKeys. Custom decoder callbacks receive plus as %20 and exceptions fall back through mutable default.unescape. Callback return values are not restricted to strings, following pinned Node behavior. Captured native URI encoding/decoding fast paths. On malformed UTF16, escape emulates Node22 legacy surrogate pairing and terminal URIError ERR_INVALID_URI. Malformed percent fallback scans UTF16 code units into bytes modulo256 then decodes nonfatal UTF8 preserving BOM through existing guest Buffer.toString. No URLSearchParams or TextEncoder substitution.", "limits": {"inputCodeUnits": 1048576, "parsedSegments": 65536, "stringifyKeys": 65536, "stringifyValues": 65536, "stringifyOutputCodeUnits": 16777216}, "deviations": ["Profile hard caps are additional to Node maxKeys and cannot be disabled by maxKeys0, negative, fractional, NaN or Infinity. Failed caps may occur after earlier callback/getter effects; no rollback is promised.", "Nonstring unescapeBuffer is explicitly deferred, including fallback after a failing nonstring unescape coercion. Native successful unescape scalar/object coercions remain supported within output input-size bound.", "unescapeBuffer allocates using supported captured Buffer.alloc rather than deferred allocUnsafe. Every returned byte is initialized; Buffer pooling/uninitialized unused backing semantics are not claimed.", "Buffer allocation, shared slice views, Uint8Array brand and UTF8 replacement follow the bounded core Buffer profile. This does not expand its encodings, limits or APIs.", "Native intrinsic and Buffer allocation/slice references are captured. Application callbacks and mutable default hooks execute with Node's inspected invocation order; arbitrary engine-specific stack/error formatting is not claimed.", "Proxy-backed arrays with noninteger/nonfinite reported lengths are deferred. Exact out-of-memory behavior and performance/size comparison remain unmeasured."], "supportedStatic": ["parse", "decode", "stringify", "encode", "escape", "unescape", "unescapeBuffer"]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.7", "nodeVe