never a host service.", "modules": {"node:stream/web": {"aliases": ["stream/web"], "status": "partial", "exports": ["ByteLengthQueuingStrategy", "CompressionStream", "CountQueuingStrategy", "DecompressionStream", "ReadableByteStreamController", "ReadableStream", "ReadableStreamBYOBReader", "ReadableStreamBYOBRequest", "ReadableStreamDefaultController", "ReadableStreamDefaultReader", "TextDecoderStream", "TextEncoderStream", "TransformStream", "TransformStreamDefaultController", "WritableStream", "WritableStreamDefaultController", "WritableStreamDefaultWriter", "default"], "callablePolicy": "Reuse thirteen real native stream/strategy constructors, implement native-bulk UTF8 codec stream facades plus serialized ReadableStream.from/values/asyncIterator, and adapt ordinary DataView BYOB requests through same-backing Uint8Array views. Compression/decompression bindings are explicit functions throwing ERR_SM_NODE_UNSUPPORTED when called or constructed. All unsupported and resource-limit errors use own coded properties; no Proxy export substitute.", "supportedStatic": ["ReadableStream.from"], "supportedPrototype": ["ReadableStream.values", "ReadableStream[Symbol.asyncIterator]", "ReadableStreamBYOBReader.read:ordinary fixed unshared views,min1", "TextEncoderStream.encoding", "TextEncoderStream.readable", "TextEncoderStream.writable", "TextDecoderStream.encoding", "TextDecoderStream.fatal", "TextDecoderStream.ignoreBOM", "TextDecoderStream.readable", "TextDecoderStream.writable"], "encodingNames": ["utf-8"], "limits": {"encoderSourceUtf16UnitsPerChunk": 1048576, "decoderInputBytesPerChunk": 16777216, "byobViewBytes": 16777216, "pendingEncoderSurrogateUnits": 1}, "importOnlyExports": ["CompressionStream", "DecompressionStream"], "deviations": ["This optional bounded module does not claim complete node:stream/web or Web Streams conformance. Existing native operations beyond the recorded ordinary corpus retain their existing implementation and unverified overloads.", "TextDeco