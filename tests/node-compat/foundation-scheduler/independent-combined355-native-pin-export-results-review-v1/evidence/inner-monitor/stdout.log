lyExports": ["Blob", "File", "SlowBuffer", "atob", "btoa", "isAscii", "isUtf8", "resolveObjectURL", "transcode"], "unsupportedStatic": ["copyBytesFrom", "of", "allocUnsafeSlow", "compare", "concat"], "unsupportedPrototypePolicy": "Every other own Node Buffer prototype function is explicitly installed as a throwing function; inventory checked against pinned Node at test time", "deviations": ["No deprecated Buffer or SlowBuffer constructor", "No slab allocator or uninitialized storage; allocUnsafe guarantees fresh zeroed exact backing at offset 0 and ignores poolSize", "No arrays, array-like inputs, DataView, non-Uint8 typed arrays, SharedArrayBuffer or resizable backing stores", "No copying slice: Buffer.slice shares storage", "Source strings limited to 1048576 UTF-16 code units", "Only allocUnsafe truncates finite nonnegative fractional sizes; other fractional sizes/index coercions remain outside the declared overloads", "Default object and constants frozen; CJS mutation synchronization unsupported", "Detached/shared/resizable ArrayBuffers and views fail ERR_SM_NODE_UNSUPPORTED; inherited Uint8Array APIs keep engine behavior", "allocUnsafe validates the raw requested size before truncation; requests above 16777216 reject even if their truncated length would fit", "allocUnsafe uses captured constructors and own data code/module/operation fields for validation; detailed Node error text and pooled backing semantics differ", "allocUnsafeSlow remains explicitly deferred; no legacy Buffer constructor or other method support follows"]}}, "requiredHostInterfaces": []}, {"schemaVersion": 1, "profileVersion": "sm-node-22.14.0-m0.2", "nodeVersion": "v22.14.0", "status": "Optional Path foundation selected only by NODE_COMPAT_PATH=ON; core m0.1 manifest is unchanged.", "moduleContract": "Explicit finite ESM export records. Root default equals posix; default and named functions initially share identity; all variants share the same posix/win32 object graph. Bare aliases select the same values, with module namespace records cached per registered specifier.", "modules": {"node:path": {"aliases": ["path"], "status": "partial", "exports": ["_makeLong", "basename", "default", "delimiter", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "posix", "relative", "resolve", "sep", "toNamespacedPath", "win32"], "callablePolicy": "All 13 callable exports implement lexical path operations; matchesGlob additionally enforces explicit profile budgets. No operation consults a host capability.", "supportedStatic": ["_makeLong", "basename", "dirname", "extname", "format", "isAbsolute", "join", "matchesGlob", "normalize", "parse", "relative", "resolve", "toNamespacedPath"], "limits": {"pathCodeUnits": 4096, "patternCodeUnits": 1024, "braceAlternatives": 128, "braceOutputCodeUnits": 32768, "braceDepth": 8, "braceRewrites": 16, "extglobDepth": 8, "segments": 128, "magicSegmentCodeUnits": 256, "stateEstimate": 65536, "workEstimate": 2000000, "workUnits": 250000, "stateKeyCodeUnits": 32768, "globstarRecursion": 32, "dfaCacheUnits": 262144}, "deviations": ["Default namespace is POSIX and virtual cwd is always '/'; no host cwd or drive-specific environment is queried.", "matchesGlob uses fixed POSIX-host case sensitivity for both variants, suppresses Node's experimental warning and uses explicitly patched minimatch 11.0.1 rather than Node 22.14's vulnerable matcher.", "matchesGlob rejects resource-budget exhaustion with RangeError code ERR_SM_NODE_PATH_BUDGET and a resource string instead of truncating expansions or returning a false result.", "TypeError names and ERR_INVALID_ARG_TYPE codes match the supported invalid input domain; received-value message rendering differs from Node's internal inspector.", "Default path objects remain mutable; ESM named bindings capture their initial members. syncBuiltinESMExports is unavailable."]}, "node:path/posix": {"aliases": ["path/posix"], "status": "partial", "exports": ["_makeLong", "b