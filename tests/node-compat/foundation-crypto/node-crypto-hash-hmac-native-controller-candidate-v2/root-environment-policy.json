{
  "schemaVersion": 1,
  "mandatoryBeforeParentAndBashSpawn": true,
  "stdlibLauncherOnlyBeforeCleanExec": true,
  "removePrefixes": [
    "BASH_FUNC_"
  ],
  "removeExactNames": [
    "BASH_ENV",
    "ENV",
    "SHELLOPTS",
    "BASHOPTS",
    "CDPATH",
    "GLOBIGNORE"
  ],
  "preserveExactNames": [
    "HOME",
    "home",
    "CODEX_HOME"
  ],
  "rootAuthorityMustBindPolicy": true,
  "actualParentAndWorkerMustContainNoRemovedEntries": true,
  "recordRemovedVariableNamesOnly": true,
  "recordEnvironmentValues": false,
  "scope": "Known Bash function/startup controls; isolated Python stdlib authentication is permitted before clean exec; not an OS sandbox"
}
