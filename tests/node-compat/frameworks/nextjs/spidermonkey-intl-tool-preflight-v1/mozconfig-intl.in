# UNEXECUTED template. Substitute only fresh private paths after Root approval.
# Derived from the genuine cmake/spidermonkey.cmake release source fallback.
ac_add_options --enable-project=js
ac_add_options --disable-js-shell
ac_add_options --target=wasm32-unknown-wasi
ac_add_options --host=aarch64-apple-darwin
ac_add_options --with-sysroot=/private/tmp/starling-node-compat/next-native-build-v5/extracted-wasi-sdk/wasi-sdk-30.0-arm64-macos/share/wasi-sysroot
ac_add_options --with-macos-sdk=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX27.0.sdk
ac_add_options --without-system-zlib
ac_add_options --with-intl-api
ac_add_options --disable-jit
ac_add_options --disable-shared-js
ac_add_options --disable-shared-memory
ac_add_options --disable-tests
ac_add_options --disable-clang-plugin
ac_add_options --enable-jitspew
ac_add_options --enable-optimize=-O3
ac_add_options --enable-js-streams
ac_add_options --enable-portable-baseline-interp
ac_add_options --disable-debug
ac_add_options --enable-lto=thin
ac_add_options --disable-bootstrap
ac_add_options --prefix=@PRIVATE_OBJECT_ROOT@/dist
mk_add_options MOZ_OBJDIR=@PRIVATE_OBJECT_ROOT@
mk_add_options MOZ_MAKE_FLAGS=-j1

# ICU4X stays enabled: this fork refuses disabling it with Intl enabled.
# No host ICU, global rustup, user mozconfig or prebuilt noIntl substitution.
