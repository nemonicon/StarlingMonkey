;; Source-only public-metadata observer v3. No core start or manual post-return.
;; The observer and unchanged inner component must be sibling instances.
(component
  (type $http-types (instance
    (export "incoming-request" (type $incoming (sub resource)))
    (export "response-outparam" (type (sub resource)))
    (export "fields" (type $fields (sub resource)))
    (export "headers" (type $headers (eq $fields)))
    (type $field-key-body string)
    (export "field-key" (type $field-key (eq $field-key-body)))
    (export "field-name" (type $field-name (eq $field-key)))
    (type $field-value-body (list u8))
    (export "field-value" (type $field-value (eq $field-value-body)))
    (type $method-body (variant
      (case "get") (case "head") (case "post") (case "put")
      (case "delete") (case "connect") (case "options") (case "trace")
      (case "patch") (case "other" string)))
    (export "method" (type $method (eq $method-body)))
    (type $get-method (func (param "self" (borrow $incoming)) (result $method)))
    (export "[method]incoming-request.method" (func (type $get-method)))
    (type $path-result (option string))
    (type $get-path (func (param "self" (borrow $incoming)) (result $path-result)))
    (export "[method]incoming-request.path-with-query" (func (type $get-path)))
    (type $get-headers (func (param "self" (borrow $incoming)) (result (own $headers))))
    (export "[method]incoming-request.headers" (func (type $get-headers)))
    (type $values (list $field-value))
    (type $get-field (func (param "self" (borrow $fields))
      (param "name" $field-name) (result $values)))
    (export "[method]fields.get" (func (type $get-field)))))
  (import "wasi:http/types@0.2.10" (instance $http (type $http-types)))
  (alias export $http "incoming-request" (type $incoming-request))
  (alias export $http "response-outparam" (type $response-outparam))
  (alias export $http "fields" (type $fields))
  (alias export $http "[method]incoming-request.method" (func $get-method))
  (alias export $http "[method]incoming-request.path-with-query" (func $get-path))
  (alias export $http "[method]incoming-request.headers" (func $get-headers))
  (alias export $http "[method]fields.get" (func $get-field))
  (core func $drop-fields (canon resource.drop $fields))

  (type $incoming-handler (instance
    (alias outer 1 $incoming-request (type $request-origin))
    (export "incoming-request" (type $request (eq $request-origin)))
    (alias outer 1 $response-outparam (type $out-origin))
    (export "response-outparam" (type $out (eq $out-origin)))
    (type $handle (func
      (param "request" (own $request))
      (param "response-out" (own $out))))
    (export "handle" (func (type $handle)))))
  ;; This standard import is internal to the future composite, not a host service.
  (import "wasi:http/incoming-handler@0.2.10" (instance $inner (type $incoming-handler)))
  (alias export $inner "handle" (func $inner-handler))
  (core func $lower-inner-handler (canon lower (func $inner-handler)))

  (type $io-error-interface (instance
    (export "error" (type (sub resource)))))
  (import "wasi:io/error@0.2.10" (instance $io-error-instance (type $io-error-interface)))
  (alias export $io-error-instance "error" (type $io-error))
  (type $streams-interface (instance
    (export "output-stream" (type $output (sub resource)))
    (alias outer 1 $io-error (type $error-origin))
    (export "error" (type $error (eq $error-origin)))
    (type $stream-error-body (variant
      (case "last-operation-failed" (own $error)) (case "closed")))
    (export "stream-error" (type $stream-error (eq $stream-error-body)))
    (type $bytes (list u8))
    (type $write-result (result (error $stream-error)))
    (type $write (func (param "self" (borrow $output))
      (param "contents" $bytes) (result $write-result)))
    (export "[method]output-stream.blocking-write-and-flush" (func (type $write)))))
  (import "wasi:io/streams@0.2.10" (instance $streams (type $streams-interface)))
  (alias export $streams "output-stream" (type $output-stream))
  (alias export $streams "[method]output-stream.blocking-write-and-flush" (func $write))

  (type $stdout-interface (instance
    (alias outer 1 $output-stream (type $output-origin))
    (export "output-stream" (type $output (eq $output-origin)))
    (type $get (func (result (own $output))))
    (export "get-stdout" (func (type $get)))))
  (import "wasi:cli/stdout@0.2.10" (instance $stdout (type $stdout-interface)))
  (alias export $stdout "get-stdout" (func $get-stdout))
  (core func $lower-get-stdout (canon lower (func $get-stdout)))
  (core func $drop-output (canon resource.drop $output-stream))
  (core func $drop-error (canon resource.drop $io-error))

  ;; Fixed memory: constants<1024; return areas1024..1087; nonce1088..1151;
  ;; output1536..2047; bump heap4096..65535. No memory growth.
  (core module $storage
    (memory (export "memory") 1 1)
    (global $heap (mut i32) (i32.const 4096))
    (func (export "reset") (global.set $heap (i32.const 4096)))
    ;; Full wasm32 canonical realloc; frees are logical until the next reset.
    (func (export "realloc") (param $old i32) (param $old-len i32)
      (param $align i32) (param $new-len i32) (result i32)
      (local $sum i32) (local $pointer i32) (local $end i32) (local $old-end i32)
      (if (i32.eqz (local.get $align)) (then unreachable))
      (if (i32.and (local.get $align) (i32.sub (local.get $align) (i32.const 1))) (then unreachable))
      (if (i32.gt_u (local.get $align) (i32.const 65536)) (then unreachable))
      (if (local.get $old) (then
        (local.set $old-end (i32.add (local.get $old) (local.get $old-len)))
        (if (i32.or (i32.lt_u (local.get $old) (i32.const 4096))
          (i32.or (i32.lt_u (local.get $old-end) (local.get $old))
            (i32.gt_u (local.get $old-end) (global.get $heap)))) (then unreachable))))
      (if (i32.eqz (local.get $new-len)) (then (return (i32.const 0))))
      (local.set $sum (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1))))
      (if (i32.lt_u (local.get $sum) (global.get $heap)) (then unreachable))
      (local.set $pointer (i32.and (local.get $sum) (i32.sub (i32.const 0) (local.get $align))))
      (local.set $end (i32.add (local.get $pointer) (local.get $new-len)))
      (if (i32.or (i32.lt_u (local.get $end) (local.get $pointer))
        (i32.gt_u (local.get $end) (i32.const 65536))) (then unreachable))
      (global.set $heap (local.get $end))
      (if (local.get $old) (then
        (memory.copy (local.get $pointer) (local.get $old)
          (select (local.get $old-len) (local.get $new-len)
            (i32.lt_u (local.get $old-len) (local.get $new-len))))))
      (local.get $pointer))
    (data (i32.const 0) "{\22marker\22:\22NEXT_STANDARD_HANDLER_RETURN_OBSERVER_V3\22,\22version\22:3,\22event\22:\22inner-handler-import-returned\22,\22method\22:")
    (data (i32.const 116) ",\22path\22:")
    (data (i32.const 124) ",\22corrState\22:")
    (data (i32.const 140) ",\22corrCount\22:")
    (data (i32.const 156) ",\22corr\22:")
    (data (i32.const 164) "}\0a")
    (data (i32.const 168) "x-next-public-request-correlation")
    (data (i32.const 204) "/actions")
    (data (i32.const 212) "/action-result")
    (data (i32.const 228) "\22GET\22")
    (data (i32.const 236) "\22POST\22")
    (data (i32.const 244) "\22unknown\22")
    (data (i32.const 256) "\22/actions\22")
    (data (i32.const 268) "\22/action-result\22")
    (data (i32.const 284) "\22missing\22")
    (data (i32.const 296) "\22valid\22")
    (data (i32.const 304) "\22invalid\22")
    (data (i32.const 316) "\22duplicate\22")
    (data (i32.const 328) "0")
    (data (i32.const 332) "1")
    (data (i32.const 336) "2")
    (data (i32.const 340) "null")
    (data (i32.const 344) "\22")
    (data (i32.const 348) "{\22marker\22:\22NEXT_STANDARD_HANDLER_RETURN_OBSERVER_V3\22,\22version\22:3,\22event\22:\22record-limit\22}\0a"))
  (core instance $storage-instance (instantiate $storage))
  (alias core export $storage-instance "memory" (core memory $memory))
  (alias core export $storage-instance "realloc" (core func $realloc))
  (alias core export $storage-instance "reset" (core func $reset))
  (core func $lower-get-method (canon lower (func $get-method) (memory $memory) (realloc $realloc) string-encoding=utf8))
  (core func $lower-get-path (canon lower (func $get-path) (memory $memory) (realloc $realloc) string-encoding=utf8))
  (core func $lower-get-headers (canon lower (func $get-headers)))
  (core func $lower-get-field (canon lower (func $get-field) (memory $memory) (realloc $realloc) string-encoding=utf8))
  (core func $lower-write (canon lower (func $write) (memory $memory)))

  (core module $implementation
    (import "observer" "memory" (memory 1 1))
    (import "observer" "reset" (func $reset))
    (import "observer" "inner-handler" (func $inner-handler (param i32 i32)))
    (import "observer" "get-method" (func $get-method (param i32 i32)))
    (import "observer" "get-path" (func $get-path (param i32 i32)))
    (import "observer" "get-headers" (func $get-headers (param i32) (result i32)))
    (import "observer" "get-field" (func $get-field (param i32 i32 i32 i32)))
    (import "observer" "drop-fields" (func $drop-fields (param i32)))
    (import "observer" "get-stdout" (func $get-stdout (result i32)))
    (import "observer" "write" (func $write (param i32 i32 i32 i32)))
    (import "observer" "drop-output" (func $drop-output (param i32)))
    (import "observer" "drop-error" (func $drop-error (param i32)))
    (global $records (mut i32) (i32.const 0))
    (func $equal (param $a i32) (param $b i32) (param $len i32) (result i32)
      (local $i i32)
      (block $done (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $a) (local.get $i)))
          (i32.load8_u (i32.add (local.get $b) (local.get $i)))) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (i32.const 1))
    (func $hex64 (param $p i32) (result i32) (local $i i32) (local $c i32)
      (block $done (loop $next
        (br_if $done (i32.ge_u (local.get $i) (i32.const 64)))
        (local.set $c (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        (if (i32.eqz (i32.or
          (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57)))
          (i32.and (i32.ge_u (local.get $c) (i32.const 97)) (i32.le_u (local.get $c) (i32.const 102)))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (i32.const 1))
    (func $append (param $dest i32) (param $src i32) (param $len i32) (result i32)
      (local $end i32)
      (local.set $end (i32.add (local.get $dest) (local.get $len)))
      (if (i32.or (i32.lt_u (local.get $dest) (i32.const 1536))
        (i32.or (i32.lt_u (local.get $end) (local.get $dest)) (i32.gt_u (local.get $end) (i32.const 2048)))) (then unreachable))
      (memory.copy (local.get $dest) (local.get $src) (local.get $len))
      (local.get $end))
    (func $append-method (param $dest i32) (param $tag i32) (result i32)
      (if (i32.eq (local.get $tag) (i32.const 1)) (then (return (call $append (local.get $dest) (i32.const 228) (i32.const 5)))))
      (if (i32.eq (local.get $tag) (i32.const 2)) (then (return (call $append (local.get $dest) (i32.const 236) (i32.const 6)))))
      (call $append (local.get $dest) (i32.const 244) (i32.const 9)))
    (func $append-path (param $dest i32) (param $tag i32) (result i32)
      (if (i32.eq (local.get $tag) (i32.const 1)) (then (return (call $append (local.get $dest) (i32.const 256) (i32.const 10)))))
      (if (i32.eq (local.get $tag) (i32.const 2)) (then (return (call $append (local.get $dest) (i32.const 268) (i32.const 16)))))
      (call $append (local.get $dest) (i32.const 244) (i32.const 9)))
    (func $append-state (param $dest i32) (param $tag i32) (result i32)
      (if (i32.eq (local.get $tag) (i32.const 1)) (then (return (call $append (local.get $dest) (i32.const 284) (i32.const 9)))))
      (if (i32.eq (local.get $tag) (i32.const 2)) (then (return (call $append (local.get $dest) (i32.const 296) (i32.const 7)))))
      (if (i32.eq (local.get $tag) (i32.const 3)) (then (return (call $append (local.get $dest) (i32.const 304) (i32.const 9)))))
      (if (i32.eq (local.get $tag) (i32.const 4)) (then (return (call $append (local.get $dest) (i32.const 316) (i32.const 11)))))
      (call $append (local.get $dest) (i32.const 244) (i32.const 9)))
    (func $append-count (param $dest i32) (param $tag i32) (result i32)
      (if (i32.eq (local.get $tag) (i32.const 0)) (then (return (call $append (local.get $dest) (i32.const 328) (i32.const 1)))))
      (if (i32.eq (local.get $tag) (i32.const 1)) (then (return (call $append (local.get $dest) (i32.const 332) (i32.const 1)))))
      (if (i32.eq (local.get $tag) (i32.const 2)) (then (return (call $append (local.get $dest) (i32.const 336) (i32.const 1)))))
      (call $append (local.get $dest) (i32.const 340) (i32.const 4)))
    (func $emit (param $pointer i32) (param $length i32) (local $stream i32)
      (local.set $stream (call $get-stdout))
      (call $write (local.get $stream) (local.get $pointer) (local.get $length) (i32.const 1024))
      (call $drop-output (local.get $stream))
      (if (i32.load8_u (i32.const 1024)) (then
        (if (i32.eqz (i32.load8_u (i32.const 1028))) (then (call $drop-error (i32.load (i32.const 1032)))))
        unreachable)))
    (func $emit-metadata (param $method i32) (param $path i32) (param $state i32) (param $count i32)
      (local $cursor i32)
      (local.set $cursor (i32.const 1536))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 0) (i32.const 114)))
      (local.set $cursor (call $append-method (local.get $cursor) (local.get $method)))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 116) (i32.const 8)))
      (local.set $cursor (call $append-path (local.get $cursor) (local.get $path)))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 124) (i32.const 13)))
      (local.set $cursor (call $append-state (local.get $cursor) (local.get $state)))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 140) (i32.const 13)))
      (local.set $cursor (call $append-count (local.get $cursor) (local.get $count)))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 156) (i32.const 8)))
      (if (i32.eq (local.get $state) (i32.const 2))
        (then
      (local.set $cursor (call $append (local.get $cursor) (i32.const 344) (i32.const 1)))
          (local.set $cursor (call $append (local.get $cursor) (i32.const 1088) (i32.const 64)))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 344) (i32.const 1)))
        )
        (else
      (local.set $cursor (call $append (local.get $cursor) (i32.const 340) (i32.const 4)))
        ))
      (local.set $cursor (call $append (local.get $cursor) (i32.const 164) (i32.const 2)))
      (call $emit (i32.const 1536) (i32.sub (local.get $cursor) (i32.const 1536))))
    (func (export "handle") (param $request i32) (param $out i32)
      (local $method i32) (local $path i32) (local $state i32) (local $count i32)
      (local $tag i32) (local $pointer i32) (local $length i32) (local $fields i32) (local $values i32)
      ;; Reset only between legal synchronous invocations; no retained slices.
      (call $reset)
      (call $get-method (local.get $request) (i32.const 1040))
      (local.set $tag (i32.load8_u (i32.const 1040)))
      (if (i32.eqz (local.get $tag)) (then (local.set $method (i32.const 1))))
      (if (i32.eq (local.get $tag) (i32.const 2)) (then (local.set $method (i32.const 2))))
      (call $get-path (local.get $request) (i32.const 1056))
      (if (i32.eq (i32.load8_u (i32.const 1056)) (i32.const 1)) (then
        (local.set $pointer (i32.load (i32.const 1060)))
        (local.set $length (i32.load (i32.const 1064)))
        (if (i32.eq (local.get $length) (i32.const 8)) (then
          (if (call $equal (local.get $pointer) (i32.const 204) (i32.const 8)) (then (local.set $path (i32.const 1))))))
        (if (i32.eq (local.get $length) (i32.const 14)) (then
          (if (call $equal (local.get $pointer) (i32.const 212) (i32.const 14)) (then (local.set $path (i32.const 2))))))
      ))
      (local.set $fields (call $get-headers (local.get $request)))
      ;; Fields child is dropped immediately after the copied-list result returns.
      ;; OOM/trap inside this imported getter can still precede the drop/forward.
      (call $get-field (local.get $fields) (i32.const 168) (i32.const 33) (i32.const 1072))
      (call $drop-fields (local.get $fields))
      (local.set $values (i32.load (i32.const 1072)))
      (local.set $length (i32.load (i32.const 1076)))
      (local.set $count (i32.const 2))
      (local.set $state (i32.const 4))
      (if (i32.eqz (local.get $length)) (then
        (local.set $count (i32.const 0)) (local.set $state (i32.const 1))))
      (if (i32.eq (local.get $length) (i32.const 1)) (then
        (local.set $count (i32.const 1)) (local.set $state (i32.const 3))
        (local.set $pointer (i32.load (local.get $values)))
        (if (i32.eq (i32.load offset=4 (local.get $values)) (i32.const 64)) (then
          (if (call $hex64 (local.get $pointer)) (then
            (memory.copy (i32.const 1088) (local.get $pointer) (i32.const 64))
            (local.set $state (i32.const 2))))))))
      ;; Unadmitted route/method clears retained correlation conservatively.
      (if (i32.or (i32.eqz (local.get $method)) (i32.eqz (local.get $path))) (then
        (local.set $state (i32.const 0)) (local.set $count (i32.const 3))))
      ;; Same one owned transfer as v2, only after child drop and snapshot copy.
      (call $inner-handler (local.get $request) (local.get $out))
      (if (i32.lt_u (global.get $records) (i32.const 256))
        (then
          (global.set $records (i32.add (global.get $records) (i32.const 1)))
          (call $emit-metadata (local.get $method) (local.get $path) (local.get $state) (local.get $count)))
        (else (if (i32.eq (global.get $records) (i32.const 256)) (then
          (global.set $records (i32.const 257))
          (call $emit (i32.const 348) (i32.const 89)))))))
  )
  (core instance $host-functions
    (export "memory" (memory $memory))
    (export "reset" (func $reset))
    (export "get-method" (func $lower-get-method))
    (export "get-path" (func $lower-get-path))
    (export "get-headers" (func $lower-get-headers))
    (export "get-field" (func $lower-get-field))
    (export "drop-fields" (func $drop-fields))
    (export "inner-handler" (func $lower-inner-handler))
    (export "get-stdout" (func $lower-get-stdout))
    (export "write" (func $lower-write))
    (export "drop-output" (func $drop-output))
    (export "drop-error" (func $drop-error)))
  (core instance $implementation-instance (instantiate $implementation
    (with "observer" (instance $host-functions))))
  (alias core export $implementation-instance "handle" (core func $handle-core))
  (type $handle-type (func
    (param "request" (own $incoming-request))
    (param "response-out" (own $response-outparam))))
  (func $handle (type $handle-type) (canon lift (core func $handle-core)))
  ;; Fresh type-only export shim, matching the unchanged Starling artifact.
  ;; It reexports the existing lifted function; no new core call/lift/start.
  (component $export-shim
    (import "import-type-incoming-request" (type (sub resource)))
    (import "import-type-response-outparam" (type (sub resource)))
    (import "import-type-incoming-request0" (type (eq 0)))
    (type (own 2))
    (import "import-type-response-outparam0" (type (eq 1)))
    (type (own 4))
    (type (func (param "request" 3) (param "response-out" 5)))
    (import "import-func-handle" (func (type 6)))
    (export "incoming-request" (type 0))
    (export "response-outparam" (type 1))
    (type (own 7))
    (type (own 8))
    (type (func (param "request" 9) (param "response-out" 10)))
    (export "handle" (func 0) (func (type 11))))
  (instance $exports (instantiate $export-shim
    (with "import-func-handle" (func $handle))
    (with "import-type-incoming-request" (type $incoming-request))
    (with "import-type-response-outparam" (type $response-outparam))
    (with "import-type-incoming-request0" (type $incoming-request))
    (with "import-type-response-outparam0" (type $response-outparam))))
  (export "wasi:http/incoming-handler@0.2.10" (instance $exports))
)
