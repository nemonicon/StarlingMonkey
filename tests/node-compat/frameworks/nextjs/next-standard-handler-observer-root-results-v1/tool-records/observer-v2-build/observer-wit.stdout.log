package root:component;

world root {
  import wasi:http/types@0.2.10;
  import wasi:http/incoming-handler@0.2.10;
  import wasi:io/error@0.2.10;
  import wasi:io/streams@0.2.10;
  import wasi:cli/stdout@0.2.10;

  export wasi:http/incoming-handler@0.2.10;
}
package wasi:http@0.2.10 {
  interface types {
    resource incoming-request;

    resource response-outparam;
  }
  interface incoming-handler {
    use types.{incoming-request, response-outparam};

    handle: func(request: incoming-request, response-out: response-outparam);
  }
}


package wasi:io@0.2.10 {
  interface error {
    resource error;
  }
  interface streams {
    use error.{error};

    resource output-stream {
      blocking-write-and-flush: func(contents: list<u8>) -> result<_, stream-error>;
    }

    variant stream-error {
      last-operation-failed(error),
      closed,
    }
  }
}


package wasi:cli@0.2.10 {
  interface stdout {
    use wasi:io/streams@0.2.10.{output-stream};

    get-stdout: func() -> output-stream;
  }
}
