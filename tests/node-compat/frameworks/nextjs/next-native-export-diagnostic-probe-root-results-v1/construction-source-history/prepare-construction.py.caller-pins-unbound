def stamp(p):
    s = p.lstat()
    return (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size, s.st_mtime_ns, s.st_ctime_ns)


def row(value):
    p = Path(value)
    require(p.is_absolute() and '..' not in p.parts and p.resolve() == p and
            not any(q.is_symlink() for q in (p, *p.parents)), 'Canonical independent input')
    s = stamp(p)
    require(stat.S_ISREG(s[2]) and s[3] == 1, 'Regular nlink1 input')
    h = hashlib.sha256()
    with p.open('rb') as f:
        for block in iter(lambda: f.read(1024**2), b''):
            h.update(block)
    require(stamp(p) == s, 'Input read changed')
    return dict(path=str(p), sha256=h.hexdigest(), bytes=s[4])


def checked(ref):
    require(type(ref) is dict and set(ref) == {'path', 'sha256', 'bytes'} and
            type(ref['bytes']) is int and ref['bytes'] >= 0 and row(ref['path']) == ref,
            'Exact descriptor')
    return Path(ref['path'])


def document(ref):
    require(type(ref) is dict and type(ref['bytes']) is int and 0 <= ref['bytes'] <= 16 * 1024**2,
            'Finite JSON bound')
    p = checked(ref)
    value = json.loads(p.read_bytes())
    checked(ref)
    return value


def family(ref):
    index = document(ref)
    root = Path(ref['path']).parent
    names, dirs = {'index.json'}, set()
    for r in index['files']:
        q = Path(r['path'])
        require(not q.is_absolute() and '..' not in q.parts and q.as_posix() == r['path'] and
                r['path'] not in names, 'Safe unique indexed member')
        names.add(r['path'])
        dirs.update(d.as_posix() for d in q.parents if d != Path('.'))
        checked(dict(r, path=str(root / q)))
    nodes = list(root.rglob('*'))
    require(all(not p.is_symlink() and (p.is_file() or p.is_dir()) for p in nodes) and
            {p.relative_to(root).as_posix() for p in nodes if p.is_file()} == names and
            {p.relative_to(root).as_posix() for p in nodes if p.is_dir()} == dirs, 'Closed Source family')
    return index


def original(ref, name):
    p = checked(ref)
    spec = importlib.util.spec_from_file_location(name, p)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    checked(ref)
    return module


def unique(refs):
    out = {}
    for r in refs:
        checked(r)
        if r['path'] in out:
            require(out[r['path']] == r, 'Conflicting evidence descriptor')
        out[r['path']] = r
    return list(out.values())


