# Resolve profile options before OpenSSL's source/configuration is selected.
option(ENABLE_BUILTIN_NODE_COMPAT "Enable bounded Node v22.14.0 guest profile" OFF)
set(NODE_COMPAT_ENTROPY_MODE "OFF" CACHE STRING "Secure entropy policy for the selected Node profile: OFF or RUNTIME_ONLY")
set_property(CACHE NODE_COMPAT_ENTROPY_MODE PROPERTY STRINGS OFF RUNTIME_ONLY)
if(NOT NODE_COMPAT_ENTROPY_MODE STREQUAL "OFF" AND NOT NODE_COMPAT_ENTROPY_MODE STREQUAL "RUNTIME_ONLY")
    message(FATAL_ERROR "NODE_COMPAT_ENTROPY_MODE must be OFF or RUNTIME_ONLY")
endif()
if(NODE_COMPAT_ENTROPY_MODE STREQUAL "RUNTIME_ONLY" AND NOT ENABLE_BUILTIN_NODE_COMPAT)
    message(FATAL_ERROR "RUNTIME_ONLY entropy requires ENABLE_BUILTIN_NODE_COMPAT=ON")
endif()
