+def verify_report_closure():
+    # Audit/index authenticate the finite accepted file list and its provenance.
+    # Re-read every consumed report/JS witness; no component is executed.
+    index = json.loads(AUDIT_INDEX_PATH.read_text())
+    for row in index['files']:
+        path = AUDIT_PATH.parent / row['path']
+        assert path.is_file() and not path.is_symlink()
+        assert sha256(path) == row['sha256'], path
+    checked = set()
+    for row in AUDIT['files']:
+        proof = row['completionProof']
+        pairs = [(REPO/proof['milestoneSummary'], proof['milestoneSummarySha256']),
+                 (REPO/proof['archivedReport'], proof['reportSha256']),
+                 (Path(proof['currentOriginalReport']), proof['reportSha256'])]
+        pairs += [(Path(w['path']),w['sha256']) for w in row.get('generatedJsReferences',[])]
+        for path,digest in pairs:
+            key = (str(path),digest)
+            if key in checked: continue
+            assert path.is_file() and not path.is_symlink(), path
+            assert sha256(path) == digest, path
+            checked.add(key)
+    return len(checked)
+
