          "line": 43,
          "text": "const raw=Buffer.concat(chunks);await output.write(name+'-body.bin',raw)"
        },
        {
          "path": "/Users/dan/dev/StarlingMonkey/tests/node-compat/foundation-stream-consumers/http-host-candidate-v1/run-body.mjs",
          "line": 45,
          "text": "}catch(error){const retry=readinessRetryAllowed"
        },
        {
          "path": "/Users/dan/dev/StarlingMonkey/tests/node-compat/foundation-stream-consumers/http-host-candidate-v1/run-body.mjs",
