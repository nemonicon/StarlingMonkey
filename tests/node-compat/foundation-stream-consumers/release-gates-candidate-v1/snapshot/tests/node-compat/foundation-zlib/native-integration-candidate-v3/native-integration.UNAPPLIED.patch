+// UNAPPLIED bounded zlib integration source. Link/runtime identity remains open.
+// Input is staged; malloc-owned codec output is copied into JS-owned storage.
+#include "builtin.h"
+#include "js/ErrorReport.h"
+#include "js/MemoryFunctions.h"
+#include "bounded-codec.h"
+#ifndef NODE_COMPAT_ZLIB
