+// Intended future target includes the StarlingMonkey source root and depends
+// on builtin_web_streams + builtin_web_text_codec through add_builtin().
+// Existing generated install order must install those builtins first. The
+// caller must enter the content realm and immediately root the return value,
+// exactly as register.cpp currently roots create_kernel().
+#include "builtin.h"
