      "kind": "EXACT_REVERSIBLE_EDITS",
      "edits": [
        {
          "label": "explicit optional codec errno",
          "before": "#include <cstring>\n",
          "after": "#include <cstring>\n#include <optional>\n"
        },
        {
          "label": "dictionary is codec need, not added dictionary support",
          "before": "DEF_ERR(NeedsDictionary, JSEXN_ERR, \"Zlib dictionaries are not supported by this profile\", 0)",
          "after": "DEF_ERR(NeedsDictionary, JSEXN_ERR, \"Missing dictionary\", 0)"
        },
        {
          "label": "errno is absent unless explicitly supplied",
          "before": "const char *code, int status = Z_OK) {",
          "after": "const char *code, std::optional<int> codec_errno = std::nullopt) {"
        },
        {
          "label": "attach only a selected codec errno",
          "before": "    JS::RootedValue number(cx, JS::Int32Value(status));\n    if (!JS_DefineProperty(cx, error, \"errno\", number, JSPROP_ENUMERATE)) return false;",
          "after": "    // A profile refusal is not a zlib errno, even when the last codec\n    // status was Z_OK or Z_STREAM_END. Never expose that diagnostic\n    // as a Node-style errno. Only actual codec errors opt in.\n    if (codec_errno) {\n      JS::RootedValue number(cx, JS::Int32Value(*codec_errno));\n      if (!JS_DefineProperty(cx, error, \"errno\", number, JSPROP_ENUMERATE)) return false;\n    }"
        },
        {
          "label": "backend mismatch remains profile error",
          "before": "return fail(cx, BackendMismatch, \"ERR_SM_ZLIB_BACKEND_MISMATCH\", Z_VERSION_ERROR);",
          "after": "return fail(cx, BackendMismatch, \"ERR_SM_ZLIB_BACKEND_MISMATCH\");"
        },
        {
          "label": "input cap has no codec errno",
          "before": "    return fail(cx, InputLimit, \"ERR_OUT_OF_RANGE\", result.zlib_status);",
          "after": "    return fail(cx, InputLimit, \"ERR_OUT_OF_RANGE\");"
        },
        {
          "label": "output cap has no codec errno",
          "before": "    return fail(cx, OutputLimit, \"ERR_BUFFER_TOO_LARGE\", result.zlib_status);",
          "after": "    return fail(cx, OutputLimit, \"ERR_BUFFER_TOO_LARGE\");"
        },
        {
          "label": "invalid data uses its actual codec error class",
          "before": "    return fail(cx, InvalidData, \"Z_DATA_ERROR\", result.zlib_status);",
          "after": "    return fail(cx, InvalidData, \"Z_DATA_ERROR\", Z_DATA_ERROR);"
        },
        {
          "label": "incomplete data uses Node codec error class",
          "before": "    return fail(cx, IncompleteData, \"Z_BUF_ERROR\", result.zlib_status);",
          "after": "    return fail(cx, IncompleteData, \"Z_BUF_ERROR\", Z_BUF_ERROR);"
        },
        {
          "label": "dictionary-required code and errno",
          "before": "    return fail(cx, NeedsDictionary, \"ERR_SM_ZLIB_DICTIONARY_UNSUPPORTED\", result.zlib_status);",
          "after": "    return fail(cx, NeedsDictionary, \"Z_NEED_DICT\", Z_NEED_DICT);"
        },
        {
          "label": "trailing policy has no codec errno",
          "before": "    return fail(cx, TrailingData, \"ERR_SM_ZLIB_TRAILING_DATA_UNSUPPORTED\", result.zlib_status);",
          "after": "    return fail(cx, TrailingData, \"ERR_SM_ZLIB_TRAILING_DATA_UNSUPPORTED\");"
        },
        {
          "label": "both internal fallback returns omit diagnostic errno",
          "before": "InternalFailure, \"ERR_SM_ZLIB_INTERNAL\", result.zlib_status",
          "after": "InternalFailure, \"ERR_SM_ZLIB_INTERNAL\"",
          "occurrences": 2
        }
      ]
